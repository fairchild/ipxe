#!ipxe
# Embedded boot script compiled into every custom iPXE binary.
# Runtime policy and endpoints are supplied by the managed PXE bootstrap named
# in DHCP. No control-plane secret is baked into this public image.
:retry
dhcp || goto retry
isset ${filename} || goto no_boot_source
chain ${filename} || goto retry

:no_boot_source
echo No PXE bootstrap script was supplied
sleep 5
goto retry
