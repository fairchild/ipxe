#!ipxe
# Embedded boot script compiled into every custom iPXE binary.
# __IPXE_SERVER_URL__ is substituted at build time from ARG IPXE_SERVER_URL.
# ${buildarch} is left for iPXE to expand at runtime (i386 / x86_64 / arm64),
# matching the ?arch= param the Worker's arch-detector uses to filter the menu.
:retry
dhcp || goto retry
ntp time.cloudflare.com || ntp pool.ntp.org || echo No NTP - TLS may fail on RTC-less boards
chain __IPXE_SERVER_URL__/boot.ipxe?arch=${buildarch} || goto retry
